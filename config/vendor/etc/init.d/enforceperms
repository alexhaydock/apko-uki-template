#!/sbin/openrc-run
# shellcheck shell=sh

description="Enforcing permissions on first boot"

start() {
    ebegin "Enforcing permissions on first boot"

    # Ensure /home/user is owned by `user`
    chown -R user:user /home/user

    # Ensure snpguest is executable
    chmod +x /usr/bin/snpguest
}

stop() {
    echo 'noop'
}
